# Cluster Connection Configuration
# ------------------------------------------------------------------
KUBECONFIG_MODE=oci # Connection mode: 'oci' or 'manual'

# OCI OKE Configuration (required when KUBECONFIG_MODE=oci)
# ------------------------------------------------------------------
OCI_TENANCY_OCID=<tenancy-ocid>
OCI_USER_OCID=<user-ocid>
OCI_REGION=<region-of-tenancy>
OCI_FINGERPRINT=<API-key-fingerprint> #gotten from the OCI console: user -> API keys -> fingerprint -> copy public key contents (ssh used to access the tenancy from the local machine CLI)
OCI_KEY_FILE=~/home/user/.oci/<ssh_key>.pem
OKE_CLUSTER_NAME=<oke-cluster-name>

# Manual Kubeconfig Configuration (required when KUBECONFIG_MODE=manual)
# ------------------------------------------------------------------
# Path relative to project root
KUBECONFIG_FILE=./kubeconfig/production.yaml

# Domain Configuration
# ------------------------------------------------------------------
DOMAIN=gitops.example.com
ACME_EMAIL=admin@example.com

# Optional Monitoring & Debugging
# ------------------------------------------------------------------
LOG_LEVEL=info                 # debug/info/warn/error (default: info)
HEALTHCHECK_TIMEOUT=30         # Seconds (default: 30)

# Security Overrides
# ------------------------------------------------------------------
GIT_SSL_NO_VERIFY=false        # "true" allows self-signed certificates
# AWS_EC2_METADATA_DISABLED=true # Uncomment to disable IMDS access
